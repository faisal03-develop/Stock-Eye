# PSX Pulse AI Backend Environment Configuration
PROJECT_NAME="PSX Pulse AI Backend"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/psx_pulse_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psx_pulse_db"

# Redis Cache & Celery Broker
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# PSX Market Hours (Pakistan Standard Time, UTC+5)
PSX_MARKET_OPEN_PKT="09:30"
PSX_MARKET_CLOSE_PKT="15:30"
PSX_TIMEZONE="Asia/Karachi"

# ML & NLP Configuration
MODEL_DIR="./models_cache"
NLP_MODEL_NAME="ProsusAI/finbert"
USE_GPU=false

# Circuit Breaker Rule
PSX_CIRCUIT_BREAKER_PCT=0.075
PSX_CIRCUIT_BREAKER_MIN_PKR=1.00

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]
API_V1_PREFIX="/api/v1"
